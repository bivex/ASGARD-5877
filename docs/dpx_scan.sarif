              "shortDescription": {
                "text": "OCaml Pattern: Cps Continuation Passing"
              },
              "fullDescription": {
                "text": "Function 'trace_ok' implements Continuation-Passing Style (CPS) ensuring stack-safe tail recursion via callback continuation"
              },
              "properties": {
                "category": "functional_idiom"
              }
            },
            {
              "id": "DPX-OCAML-CLOSURE_CURRYING_STRATEGY",
              "name": "closure_currying_strategy",
